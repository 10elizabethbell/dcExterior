      "html": "<a class=\"ds-row\" href=\"#\"><svg class=\"ds-ico\" viewBox=\"0 0 40 40\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 21L20 7l17 14\"/><path d=\"M8 17v16h24V17\"/><path d=\"M14 23h12M12 28h16\"/></svg><span><b>Roof</b><span class=\"ds-signs\">Missing shingles · leaks · moss</span></span><span class=\"ds-arrow\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\"><path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></a>",
      "css": ".ds-row{display:grid;grid-template-columns:40px 1fr 44px;gap:16px;align-items:center;padding:20px 0;text-decoration:none;color:var(--ink);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.ds-row:focus-visible{outline:none}.ds-ico{width:40px;height:40px;color:var(--blue);align-self:start;margin-top:2px}.ds-row b{display:block;font-family:var(--display);font-weight:400;font-size:clamp(21px,5.6vw,25px);line-height:1.15}.ds-signs{display:block;margin-top:6px;font:16px/1.5 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:var(--soft)}.ds-arrow{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:rgba(11,35,64,.07);color:var(--ink);transition:background-color .2s}.ds-row:hover .ds-arrow{background:var(--yellow)}.ds-row:focus-visible .ds-arrow{background:var(--yellow);outline:3px solid var(--blue);outline-offset:3px}"
