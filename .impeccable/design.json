      "css": ".ds-band-deep{background-color:var(--deep);background-image:var(--texture);color:var(--on-dark-soft);padding:32px;font:16px/1.7 -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}.ds-step{display:grid;grid-template-columns:48px 1fr;gap:16px;align-items:start}.ds-num{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:var(--yellow);color:var(--ink);font-family:var(--display);font-weight:400;font-size:20px;line-height:1}.ds-step b{display:block;font-family:var(--display);font-weight:400;font-size:21px;line-height:1.2;color:var(--on-dark);margin-top:4px}.ds-step span:not(.ds-num){display:block;margin-top:4px}"
