  "narrative": {
    "northStar": "The Ad's Navy Band, Made Into a Page",
    "overview": "The site is DC Exterior's own Facebook ad stretched to a full page: the ad's navy band becomes the hero and the closing bands, its headline yellow becomes the one warm fill, and the logo's bright blue carries icons and focus. Between the navy bands sit calm off-white paper bands, where the work content lives. The result reads as a sturdy local trade: plain, confident, nothing decorative that the business itself does not own.\n\nDensity is low and phone-first. Every band is one idea (who and the offer, what we fix, how a quote works, the quote form, the closing line), stacked as full-width bands with generous vertical padding. Depth comes from band colour alternation and a faint diagonal line texture on the navy grounds, not from shadows. Type is Cal Sans for every heading, label and button, over a system sans body at 16/1.7.\n\nThere is no photography: no real job photos exist, and the ad's house is an illustration, so the hero is a plain textured navy field with the real logo. Contact is Messenger only; no phone or email affordance is ever drawn.",
    "keyCharacteristics": [
      "Alternating full-width bands: navy hero, paper, deep navy, paper, navy, deep footer.",
      "One warm fill (the ad's yellow) for the primary action, step numbers and the floating message circle.",
      "Logo blue for line icons and focus on light grounds; yellow takes over focus on dark grounds.",
      "Cal Sans at weight 400 for every display role; system sans for reading.",
      "Pill buttons and chips, a 24px-cornered white form card, flat surfaces.",
      "Motion limited to a hero letter bounce-in and a 12px fade-up for content below the first screen."
    ],
    "rules": [
      {
        "name": "The One Warm Fill Rule",
        "body": "Yellow is the only warm colour on the page and on light grounds it appears only as a fill with Navy Ink text on it. Its one text use is the accent clause of a heading on a navy ground.",
        "section": "colors"
      },
      {
        "name": "The Blue Is a Signal Rule",
        "body": "Logo Blue marks what you can act on or where focus is (icons, focus rings, hover borders). It never fills a button or a band.",
        "section": "colors"
      },
      {
        "name": "The Focus Swaps With the Ground Rule",
        "body": "Focus outlines are 3px Logo Blue on paper and white, 3px yellow on navy and deep navy.",
        "section": "colors"
      },
      {
        "name": "The Single Weight Rule",
        "body": "Cal Sans is always weight 400. Hierarchy comes from size, never from bolding the display face; the body face goes to 600 only for a short bold lead-in (\"DC Exterior.\").",
        "section": "typography"
      },
      {
        "name": "The Second Clause Rule",
        "body": "A heading on a navy ground may set its closing clause in yellow; headings on paper stay all Navy Ink.",
        "section": "typography"
      },
      {
        "name": "The Texture Only on Navy Rule",
        "body": "The line texture appears on the hero and deep-navy bands; paper bands and cards stay untextured.",
        "section": "elevation"
      },
      {
        "name": "The Rows Don't Lift Rule",
        "body": "Interactive rows and link cards never gain a shadow or background on hover; only their arrow disc reacts.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do alternate bands of paper and navy/deep navy, with the line texture on navy grounds only.",
      "Do keep yellow a fill with Navy Ink text on light grounds; let it colour only the closing clause of a heading on navy.",
      "Do use Logo Blue for icons and focus on light grounds and switch focus to yellow on navy.",
      "Do set every heading, label and button in Cal Sans at weight 400.",
      "Do make every press target a pill or circle at least 44px (buttons 56px, chips 48px).",
      "Do gate hover styles behind `(hover:hover)` so taps don't leave them stuck.",
      "Do route every contact action to Messenger."
    ],
    "donts": [
      "Don't put yellow text on paper or white; use `yellow-ink` if it is ever unavoidable.",
      "Don't fill buttons or bands with Logo Blue, and don't set the logo on a black ground.",
      "Don't add shadows to cards, rows or buttons; the floating circle is the only lifted element.",
      "Don't draw phone, email or address affordances; the business publishes none.",
      "Don't stand in for missing job photos with stock or illustration.",
      "Don't replace the floating circle with a sticky bottom bar.",
      "Don't animate anything visible at load other than the hero H1."
    ]
  }
}
